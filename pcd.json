  "repository": "https://github.com/superdarki/profilarr",
  "links": {
    "homepage": "https://github.com/superdarki/profilarr"
  },
  "profilarr": {
    "minimum_version": "2.0.0"
  },
  "tags": [
    "french",
    "fr",
    "dumpstarr",
    "anime",
    "combined"
  ],
  "upstream": {
    "fr": {
      "repo": "https://github.com/Jojont54/Profilarr-database-french-regex",
